              <div class="lgn_inptcrdcl"><input
                  type="lgn_eml"
                  id="lgn_eml"
                  name="email"
                  placeholder="Your Email Address"
                  class="lgn_inptcl"
                  required=""
                /></div>
              <div class="lgn_inptcrdcl">
                <input
                  type="password"
                  id="lgn_pwd"
                  name="lgn_pwd"
                  placeholder="Enter Password"
                  class="lgn_inptcl"
                  required=""
                />
                <button id="lgn_pwd_seecnfrmpwdicn">
