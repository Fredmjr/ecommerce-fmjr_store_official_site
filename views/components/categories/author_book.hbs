<div id="authrbookspg">
  <div id="authrbookspgcntnts">
    {{! books banner }}
    <div id="portflpgcntnts_bksbnnr">
      <img
        class="portflpgcntnts_bksbnnr_thumbnl"
        src="dist/imgs/fmjr_stores default author_books.webp"
        alt=""
      />
    </div>
    {{! category }}
    <div id="authrbookspgcntnts_ctgry"></div>
    {{! main contents }}
    <div id="authrbookspgcntnts_maincntnts">
      <div id="authrbookspgcntnts_maincntnts_sidemenu">
        <div id="authrbookspgcntnts_maincntnts_sidemenu_ttl">Events &
          Announcements</div>
        <div id="authrbookspgcntnts_maincntnts_sidemenu_contnets">
          <div id="generic_empty_event_clndnr">
            <div>
              <div id="generic_empty_event_clndnr_img"><img
                  src="dist/imgs/calendar_events_unavailable.webp"
                  width="45"
                /></div>
              <p style="text-align:center;">No Upcoming Events</p>
            </div>
          </div>
        </div>
      </div>
      <div id="authrbookspgcntnts_maincntnts_contents">
        {{! book card }}
        <div class="authrbookspgcntnts_maincntnts_contents_cookcrd">
          <div class="authrbookspgcntnts_maincntnts_contents_cookcrd_thmbnl">
            <div
              class="authrbookspgcntnts_maincntnts_contents_cookcrd_thmbnl_popupricetag"
            ></div>
          </div>
          <div class="authrbookspgcntnts_maincntnts_contents_cookcrd_info">
            <p
              class="authrbookspgcntnts_maincntnts_contents_cookcrd_info_ttl"
            >Through The Scripture, The Scripture is Key Uncut Edition</p>
            <p
              class="authrbookspgcntnts_maincntnts_contents_cookcrd_info_dscrptn"
            >Lorem ipsum dolor sit amet consectetur adipisicing elit. Deserunt
              facere ipsum corporis saepe ad voluptates, vitae pariatur.</p>
            <br /><br />
            <div
              class="authrbookspgcntnts_maincntnts_contents_cookcrd_info_btm"
            >
              {{!  <div
                class="authrbookspgcntnts_maincntnts_contents_cookcrd_info_btm_lft"
              >K<span>0</span>.00</div> }}
              <div
                class="authrbookspgcntnts_maincntnts_contents_cookcrd_info_btm_rght"
              >
                <button
                  class="authrbookspgcntnts_maincntnts_contents_cookcrd_info_btm_rght_buynowbtn"
                >Buy Now</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>