<div id="ordrnowbk_sctn">
  <div id="ordrnowbk_sctn_cntnts">
    <p id="ordrnowbk_sctn_ttl">Choose Payment Method</p>
    {{! methods }}
    <div id="ordrnowbk_sctn_pymntmethod_pnl">
      <button class="ordrnowbk_sctn_pymntmethod_ntnscl">Mobile Money</button>
      <button class="ordrnowbk_sctn_pymntmethod_ntnscl">MasterCard</button>
      <button class="ordrnowbk_sctn_pymntmethod_ntnscl">VISA Payment</button>
    </div>
    {{! contents }}
    <div>
      <p class="prfl_sectn_tem_crd_pflinfo_ttlcl">Amount</p>
      <p class="prfl_sectn_tem_crd_pflinfo_dscrptncl">K75.00</p>
      <div class="sgnup_inptcrdcl">
        <input
          type="tel"
          id="sgnup_cntct"
          name="contact_number"
          placeholder="e.g., +260 975986004"
          class="sgnup_inptcl"
          required=""
        />
      </div>
      <br />
      <div id="ordrnowbk_sctn_oprtorspnl">
        <div
          class="cors_clss_wrkspcpg_cntnts_main_crdlet_info_top_nmtags_typetag"
        >Airtel</div>
        <div
          class="cors_clss_wrkspcpg_cntnts_main_crdlet_info_top_nmtags_typetag"
        >MTN</div>
        <div
          class="cors_clss_wrkspcpg_cntnts_main_crdlet_info_top_nmtags_typetag"
        >Zamtell</div>
      </div>
    </div>
  </div>
</div>