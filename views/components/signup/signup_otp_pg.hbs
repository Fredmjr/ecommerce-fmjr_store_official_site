<div id="frgotpwdpg">
  <div id="frgotpwdpgcntnts">
    <div id="frgotpwdpgcntnts_tplogo">
      <img src="assets/logos/fmjr_stores official.png" width="25" alt="" />
    </div>
    <p id="frgotpwd_ttl">Verify Account</p>
    <p id="frgotpwd_dscrptn">Code was sent to your email address to authenticate
      your login.</p>
    <br />
    {{! code panel }}
    <div id="lgn_otp_pg_codepnl">
      <div class="lgn_otp_pg_codecrdcl">
        <input
          id="lgn_otp_pg_codecrd_id_0"
          type="text"
          required=""
          maxlength="1"
          pattern="[0-9]"
          class="lgn_otp_pg_codecrdlet_cl"
        />
      </div>
      <div class="lgn_otp_pg_codecrdcl">
        <input
          id="lgn_otp_pg_codecrd_id_1"
          type="text"
          required=""
          maxlength="1"
          pattern="[0-9]"
          class="lgn_otp_pg_codecrdlet_cl"
        />
      </div>

      <div class="lgn_otp_pg_codecrdcl">
        <input
          id="lgn_otp_pg_codecrd_id_2"
          type="text"
          required=""
          maxlength="1"
          pattern="[0-9]"
          class="lgn_otp_pg_codecrdlet_cl"
        />
      </div>
      <div class="lgn_otp_pg_codecrdcl">
        <input
          id="lgn_otp_pg_codecrd_id_3"
          type="text"
          required=""
          maxlength="1"
          pattern="[0-9]"
          class="lgn_otp_pg_codecrdlet_cl"
        />
      </div>
      <div class="lgn_otp_pg_codecrdcl">
        <input
          id="lgn_otp_pg_codecrd_id_4"
          type="text"
          required=""
          maxlength="1"
          pattern="[0-9]"
          class="lgn_otp_pg_codecrdlet_cl"
        />
      </div>
      <div class="lgn_otp_pg_codecrdcl">
        <input
          id="lgn_otp_pg_codecrd_id_5"
          type="text"
          required=""
          maxlength="1"
          pattern="[0-9]"
          class="lgn_otp_pg_codecrdlet_cl"
        />
      </div>
    </div>
    {{! err panel }}
    <div id="lgn_errmgs_pnl" style="display: none;"></div>
    <br />
    {{! <button id="lgn_otp_pg_rsbdotpcodebtn">Resend Code</button><br /> }}
    <br />
    {{!     <div class="frgotpwd_inptcrdcl"><input
        type="frgotpwd_eml"
        id="frgotpwd_eml"
        name="email"
        placeholder="Enter Email Address"
        class="frgotpwd_inptcl"
        required=""
      /></div> }}

    <button id="sgnup_otp_pg_submitbtn">Submit</button>
  </div>
</div>