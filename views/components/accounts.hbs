<div id="accntspg">
  <div id="accntspgcntnts">
    {{! x2 banners }}
    <div id="accntspgcntnts_bnnr">Account Management</div>

    <div id="accntspgcntnts_bnnrpwsmngmnt_bnnr">
      <span><img
          id="accntspgcntnts_bnnrpwsmngmnt_bnnr_img"
          src="dist/imgs/fmjr_stores account managment thumbnail.webp"
          alt=""
        /></span>
    </div>
    {{! account details }}
    {{! title bar }}
    <button id="accntspgcntnts_subbnnr">
      <p id="accntspgcntnts_subbnnrlft">Account Details</p>
      <span id="accntspgcntnts_subbnnrrghtBtn">
        <img
          id="accntspgcntnts_subbnnrrghtBtnicn"
          src="dist/icons/down arrow.svg"
          width="5"
        />
      </span>
    </button>
    {{! info }}
    <div id="accntspgcntnts_accntdtls" style="display: none;">
      <div id="accntspgcntnts_ldngicn"><img
          class="ldngicn"
          width="30"
          src="dist/icons/loading.svg"
          alt=""
        /></div>
    </div>

    {{! Password Mnagment }}
    {{! title bar }}
    <button id="accntspgcntnts_bnnrpwsmngmnt">
      <p class="accntspgcntnts_genericttlbnnr">Password Management</p>
      <span class="accntspgcntnts_genericttlbnnricnpnl">
        <img
          class="accntspgcntnts_genericttlbnnricn"
          id="accntspgcntnts_genericttlbnnricnid"
          src="dist/icons/down arrow.svg"
          width="5"
        />
      </span>
    </button>
    {{! Info }}
    <div id="accntspgcntnts_accntdtls2" style="display: none;">
      {{! old password }}
      {{!       <label for="accntspgcntnts_oldpwdinpt">Old Password</label>
      <div class="accntspgcntnts_inptcrdcl">
        <input
          id="accntspgcntnts_oldpwdinpt"
          name="accntspgcntnts_oldpwdinpt"
          placeholder="Enter Password"
          type="password"
          class="accntspgcntnts_inptcl"
          required
        />
        <button
          id="accntspgcntnts_oldpwdinpt_seepwdicn"
          class="accntspgcntnts_pwd_seepwdicnimg"
        ><img
            id="accntspgcntnts_oldpwdinpt_seepwdicnimg"
            src="dist/icons/open-eye.svg"
            width="17"
          /></button>
      </div> }}
      {{! forgot password }}
      {{!       <button id="lgn_frgtpwdBtn">Forgot Password</button> }}
      {{! new passsword }}
      {{!       <label for="accntspgcntnts_newpwdinpt">New Password</label>
      <div class="accntspgcntnts_inptcrdcl">
        <input
          id="accntspgcntnts_newpwdinpt"
          name="accntspgcntnts_newpwdinpt"
          placeholder="Create Password"
          type="password"
          class="accntspgcntnts_inptcl"
          required
        />
        <button
          id="accntspgcntnts_newpwdinpt_seepwdicn"
          class="accntspgcntnts_pwd_seepwdicnimg"
        ><img
            id="accntspgcntnts_newpwdinpt_seepwdicnimg"
            src="dist/icons/open-eye.svg"
            width="17"
          /></button>
      </div> }}
      {{! confirm passsword }}
      {{!       <label for="accntspgcntnts_cnfrmpwdinpt">Confirm Password</label>
      <div class="accntspgcntnts_inptcrdcl">
        <input
          id="accntspgcntnts_cnfrmpwdinpt"
          name="accntspgcntnts_cnfrmpwdinpt"
          placeholder="Confirm Password"
          type="password"
          class="accntspgcntnts_inptcl"
          required
        />
        <button
          id="accntspgcntnts_cnfrmpwdinpt_seepwdicn"
          class="accntspgcntnts_pwd_seepwdicnimg"
        ><img
            id="accntspgcntnts_cnfrmpwdinpt_seepwdicnimg"
            src="dist/icons/open-eye.svg"
            width="17"
          /></button>
      </div> }}

      {{!  <button id="accntspgcntnts_svaccntsdtlsBtn">Save Changes</button> }}

      <div id="accntspgcntnts_svaccntsdtls_passwdmngmnt"><img
          class="ldngicn"
          width="30"
          src="dist/icons/loading.svg"
          alt=""
        /></div>
    </div>
    {{! Tutor, Course &  Class}}
    {{! title bar }}
    <button id="accntspgcntnts_ttr_crs_clss_bnnr">
      <p id="accntspgcntnts_ttr_crs_clss_bnnr_lft">Register Tutor Account</p>
      <span id="accntspgcntnts_ttr_crs_clss_bnnr_btn">
        <img
          id="accntspgcntnts_ttr_crs_clss_bnnr_btnicn"
          src="dist/icons/down arrow.svg"
          width="5"
        />
      </span>
    </button>
    {{! info }}
    <div id="accntspgcntnts_ttr_crs_clss_sec" style="display: none;">
      <p>Tutor Account Info Details</p>
      {{! err panel }}
      <div
        id="authrbookspgcntnts_mainermgs_ermgpnl"
        style="display: none;"
      ></div>
      <div class="accntspgcntnts_ttr_crs_clss_sec_ttrs_inputpnl">
        <input
          type="text"
          id="ttr_nm"
          name="ttr_nm"
          placeholder="Enter Tutor Username"
          class="sgnup_inptcl"
          required=""
        />
      </div>
      {{!    <div class="accntspgcntnts_ttr_crs_clss_sec_ttrs_inputpnl">
        <input
          type="text"
          id="ttr_eml"
          name="ttr_eml"
          placeholder="Enter Email Address"
          class="sgnup_inptcl"
          required=""
        />
      </div> 
       <br />
      }}

      <div class="accntspgcntnts_ttr_crs_clss_sec_ttrs_inputpnl">
        <input
          type="text"
          id="ttr_website"
          name="ttr_website"
          placeholder="Enter Website Link (Optional)"
          class="sgnup_inptcl"
          required=""
        />
      </div>
      <br />
      <div class="accntspgcntnts_ttr_crs_clss_sec_ttrs_inputpnl">
        <input
          type="text"
          id="ttr_fb_hndl"
          name="ttr_fb_hndl"
          placeholder="Enter Facebook Handle (Optional)"
          class="sgnup_inptcl"
          required=""
        />
      </div>
      <div class="accntspgcntnts_ttr_crs_clss_sec_ttrs_inputpnl">
        <input
          type="text"
          id="ttr_instgrm_hndl"
          name="ttr_instgrm_hndl"
          placeholder="Enter Instagram Handle (Optional)"
          class="sgnup_inptcl"
          required=""
        />
      </div>
      <div class="accntspgcntnts_ttr_crs_clss_sec_ttrs_inputpnl">
        <input
          type="text"
          id="ttr_ticktok_hndl"
          name="ttr_tiktok_hndl"
          placeholder="Enter Tik Tok Handle (Optional)"
          class="sgnup_inptcl"
          required=""
        />
      </div>
      <div class="accntspgcntnts_ttr_crs_clss_sec_ttrs_inputpnl">
        <input
          type="text"
          id="ttr_bhnc_hndl"
          name="ttr_bhnc_hndl"
          placeholder="Enter Behance Handle (Optional)"
          class="sgnup_inptcl"
          required=""
        />
      </div>

      <br />
      <div class="accntspgcntnts_ttr_crs_clss_sec_ttrs_inputpnl">
        <input
          type="tel"
          placeholder="e.g., +260 975986004"
          id="ttr_cntct_1"
          name="ttr_cntct_1"
          placeholder="Enter Conatct Line 1"
          class="sgnup_inptcl"
          required=""
        />
      </div>
      <div class="accntspgcntnts_ttr_crs_clss_sec_ttrs_inputpnl">
        <input
          type="tel"
          placeholder="e.g., +260 975986004"
          id="ttr_cntct_2"
          name="ttr_cntct_2"
          placeholder="Enter Conatct Line 2 (Optional)"
          class="sgnup_inptcl"
          required=""
        />
      </div>
      <br />
      <label for="accntspgcntnts_ttr_crs_clss_sec_ttrs_dscrptn">Tutor
        Description</label>
      <textarea
        id="accntspgcntnts_ttr_crs_clss_sec_ttrs_dscrptn"
        class="accntspgcntnts_ttr_crs_clss_sec_ttrs_dscrptn_cl"
        rows="5"
        cols="40"
        placeholder="Describe a bit about yourself..."
        style="height: 41px;"
      ></textarea>
      <br />
      <br /><br />
      <p>Payment Account Details
        <p>Mobile Details</p>
        <div class="accntspgcntnts_ttr_crs_clss_sec_ttrs_inputpnl">
          <input
            type="text"
            id="ttr_mblsrvcs_nm"
            name="ttr_mblsrvcs_nm"
            placeholder="Enter Account Username"
            class="sgnup_inptcl"
            required=""
          />
        </div>
        <div class="accntspgcntnts_ttr_crs_clss_sec_ttrs_inputpnl">
          <input
            type="tel"
            id="ttr_mblsrvcs_phn"
            name="contact_number"
            placeholder="e.g., +260 975986004"
            class="sgnup_inptcl"
            required=""
          />
        </div>
        <p>Choose Mobile Service Operator:
          <span id="tt_usr_dsply_oprtr_id">unlisted operator</span></p>
        <div id="accntspgcntnts_ttr_crs_clss_sec_ttrs_mblsrvcs">
          <div
            data-oprtr="airtel"
            class="cors_clss_wrkspcpg_cntnts_main_crdlet_info_top_nmtags_typetag"
          >airtel zambia</div>
          <div
            data-oprtr="mtn"
            class="cors_clss_wrkspcpg_cntnts_main_crdlet_info_top_nmtags_typetag"
          >mtn zambia</div>
          <div
            data-oprtr="zamtel"
            class="cors_clss_wrkspcpg_cntnts_main_crdlet_info_top_nmtags_typetag"
          >zamtel zambia</div>

        </div>
        <br />
        <br />
        <p>Bank / Card</p>
        <p>Service Currently Unavailable.</p>

        <br /><br />
        <p>Tutor Account Profile Image</p>
        <br />
        <div
          id="authrbookspgcntnts_maincntnts_contents_hirebkspc_pnl_attcmntfile_pnl"
        >
          <div
            id="authrbookspgcntnts_maincntnts_contents_hirebkspc_pnl_attcmntfile_pnl_img"
          ><img
              src="dist/imgs/upload_file_thumbnail.webp"
              width="40"
              alt=""
            /></div>

          <p
            id="authrbookspgcntnts_maincntnts_contents_hirebkspc_pnl_attcmntfile_pnl_txt"
          >Drag and drop file here or
            <span
              id="authrbookspgcntnts_maincntnts_contents_hirebkspc_pnl_attcmntfile_pnl_txtlink"
            >Choose file</span></p>
          <input
            type="file"
            id="authrbookspgcntnts_maincntnts_contents_hirebkspc_pnl_attcmntfile_pnl_txtlink_filinput"
            style="display:none;"
            {{!  multiple="" }}
            accept=".png"
          />
        </div>
        <div
          id="authrbookspgcntnts_maincntnts_contents_hirebkspc_pnl_flfrmt"
        ><span>Supported format: png</span><span>Maximum size: 10MB</span></div>
        <div
          id="authrbookspgcntnts_maincntnts_contents_hirebkspc_pnl_rdytouploadfiles_ermgpnl"
        ></div>
        <div
          id="authrbookspgcntnts_maincntnts_contents_hirebkspc_pnl_rdytouploadfiles"
        ></div>
        <button
          id="accntspgcntnts_ttr_crs_clss_sec_ttrs_submittttrformbtn"
        >Submit</button>
      </p>
    </div>

    {{! calendar upload }}
    {{! title bar }}{{! info }}
    <button id="accntspgcntnts_subbnnrclndr">
      <p id="accntspgcntnts_subbnnrclndrlft">Calendar & Schedules</p>
      <span id="accntspgcntnts_subbnnrclndrrghtBtn">
        <img
          id="accntspgcntnts_subbnnrclndrBtnicn"
          src="dist/icons/down arrow.svg"
          width="5"
        />
      </span>
    </button>
    {{! info }}
    <div id="accntspgcntnts_subbnnrclndrsec" style="display: none;">
      <p class="accntspgcntnts_subbnnrclndrsec_generictxt">Create New Event</p>

      {{! date selection }}
      <div id="accntspgcntnts_subbnnrclndrsec_cntnts">
        <div id="accntspgcntnts_subbnnrclndrsec_datepnl">
          {{! day }}
          <div class="accntspgcntnts_subbnnrclndrseccl_datecl">
            <button
              class="accntspgcntnts_subbnnrclndrseccl_datecl_btnscl1"
              id="accntspgcntnts_subbnnrclndrseccl_dateadddaybtn"
            ><img
                src="dist/icons/down arrow.svg"
                width="5"
                style="transform: rotate(180deg);"
                class="accntspgcntnts_subbnnrclndrseccl_datecl_icnscl"
              /></button>
            <p
              class="accntspgcntnts_subbnnrclndrseccl_datecl_txtcl"
              id="accntspgcntnts_subbnnrclndrseccl_date_dayid"
            >1</p>
            <button
              class="accntspgcntnts_subbnnrclndrseccl_datecl_btnscl2"
              id="accntspgcntnts_subbnnrclndrseccl_datesubdaybtn"
            ><img
                src="dist/icons/down arrow.svg"
                width="5"
                style="transform: rotate(0deg);"
                class="accntspgcntnts_subbnnrclndrseccl_datecl_icnscl"
              /></button>
          </div>
          {{! month }}
          <div id="accntspgcntnts_subbnnrclndrseccl_dateclmd">
            <button
              class="accntspgcntnts_subbnnrclndrseccl_datecl_btnscl1"
              id="accntspgcntnts_subbnnrclndrseccl_datenxtmnthbtn"
            ><img
                src="dist/icons/down arrow.svg"
                width="5"
                style="transform: rotate(180deg);"
                class="accntspgcntnts_subbnnrclndrseccl_datecl_icnscl"
              /></button>
            <p
              class="accntspgcntnts_subbnnrclndrseccl_datecl_txtcl"
              id="accntspgcntnts_subbnnrclndrseccl_date_mnthid"
            >July</p>
            <button
              class="accntspgcntnts_subbnnrclndrseccl_datecl_btnscl2"
              id="accntspgcntnts_subbnnrclndrseccl_dateprvusmnthbtn"
            ><img
                src="dist/icons/down arrow.svg"
                width="5"
                style="transform: rotate(0deg);"
                class="accntspgcntnts_subbnnrclndrseccl_datecl_icnscl"
              /></button>
          </div>
          {{! year }}
          <div class="accntspgcntnts_subbnnrclndrseccl_datecl">
            <button
              class="accntspgcntnts_subbnnrclndrseccl_datecl_btnscl1"
              id="accntspgcntnts_subbnnrclndrseccl_datenextyrbtn"
            ><img
                src="dist/icons/down arrow.svg"
                width="5"
                style="transform: rotate(180deg);"
                class="accntspgcntnts_subbnnrclndrseccl_datecl_icnscl"
              /></button>
            <p
              class="accntspgcntnts_subbnnrclndrseccl_datecl_txtcl"
              id="accntspgcntnts_subbnnrclndrseccl_date_yrid"
            >2026</p>
            <button
              class="accntspgcntnts_subbnnrclndrseccl_datecl_btnscl2"
              id="accntspgcntnts_subbnnrclndrseccl_datenprvusyrbtn"
            ><img
                src="dist/icons/down arrow.svg"
                width="5"
                style="transform: rotate(0deg);"
                class="accntspgcntnts_subbnnrclndrseccl_datecl_icnscl"
              /></button>
          </div>
        </div>
      </div>
      <div class="accntspgcntnts_inptcrdcl">
        <input
          class="accntspgcntnts_inptcl"
          id="accntspgcntnts_subbnnrclndrsec_details_eventttl"
          placeholder="Enter Event Title"
          required=""
        />
      </div>
      <textarea
        class="accntspgcntnts_subbnnrclndrsec_dscrptnbox"
        rows="5"
        cols="40"
        placeholder="Describe your event"
      ></textarea>
      <br /><br />
      <div id="accntspgcntnts_subbnnrclndrsec_crtbtnpnl">
        <button id="accntspgcntnts_subbnnrclndrsec_crtbtn">Create</button>
      </div>
    </div>

    <br /><br />
    <div id="accntspgcntnts_lgnoutBtnpnl">
      <button id="accntspgcntnts_lgnoutBtn"><img
          class="logouticn"
          width="12"
          src="dist/icons/logout.svg"
          alt=""
        />Log out</button>
    </div>
  </div>

</div>